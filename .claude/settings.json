{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*keypair*.json)",
      "Read(~/.trade-secrets/**)",
      "Read(~/.config/solana/**)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(~/.trade-secrets/**)",
      "Bash(solana transfer *)",
      "Bash(solana-keygen *)",
      "Bash(spl-token transfer *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(cat .env*)",
      "Bash(cat ~/.trade-secrets/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_secrets.py"
          }
        ]
      }
    ]
  }
}
