# Copia questo file in ".env" e inserisci i valori SOLO nel file .env sul tuo Mac.
# Non incollare mai questi valori in chat. Il file .env è escluso da git.
# NON inserire qui chiavi private del wallet: quelle stanno in ~/.trade-secrets/ e le legge solo il Signer.

TRADE_MODE=OFF

HELIUS_API_KEY=
JUPITER_API_KEY=
COINGECKO_DEMO_API_KEY=
# GoPlus: nomi delle credenziali da confermare sulla documentazione ufficiale in Fase 3

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Fase 8 (opzionale)
ANTHROPIC_API_KEY=
